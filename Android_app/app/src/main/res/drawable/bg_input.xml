<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: lime border when the user is typing in it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gym_surface" />
            <stroke android:width="2dp" android:color="@color/gym_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gym_surface" />
            <stroke android:width="1dp" android:color="@color/gym_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
