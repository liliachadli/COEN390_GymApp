<?xml version="1.0" encoding="utf-8"?>
<!-- One rep: number, ROM bar, TUT, speed -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/rep_number"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gym_text_secondary"
        android:textSize="14sp" />

    <!-- ROM bar: the lime/violet part is rom %, the grey part is the rest -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_bar_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/rep_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bar_fill"
            android:backgroundTint="@color/gym_violet" />

        <View
            android:id="@+id/rep_bar_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/rep_rom"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:textColor="@color/gym_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/rep_tut"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gym_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/rep_speed"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gym_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
