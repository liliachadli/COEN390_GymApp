<?xml version="1.0" encoding="utf-8"?>
<!-- 2 · History -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_side"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/screen_side"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Gym.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="32sp" />

            <!-- Stats | Workouts tabs -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/history_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_stats"
                    style="@style/Gym.Button.Toggle"
                    android:text="Stats" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_workouts"
                    style="@style/Gym.Button.Toggle"
                    android:text="Workouts" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Charts, added by StatsSection -->
            <LinearLayout
                android:id="@+id/stats_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/workouts_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="RECENT WORKOUTS" />

                <TextView
                    android:id="@+id/empty_text"
                    style="@style/Gym.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No workouts yet. Finish one and it will show here."
                    android:visibility="gone" />

                <!-- One card per workout, added by HistoryActivity -->
                <LinearLayout
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Gym.BottomNav"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
