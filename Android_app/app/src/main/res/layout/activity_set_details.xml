<?xml version="1.0" encoding="utf-8"?>
<!-- 1.1.2 · Set details: live data while the set is happening -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Gym.Button.Danger"
            android:text="Cancel" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/state_chip"
            style="@style/Gym.Chip"
            android:letterSpacing="0.1"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="● WAITING" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finish_button"
            style="@style/Gym.Button.Small"
            android:enabled="false"
            android:text="Finish" />
    </LinearLayout>

    <TextView
        android:id="@+id/set_title"
        style="@style/Gym.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/set_subtitle"
        style="@style/Gym.Text.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_tile"
            android:backgroundTint="@color/gym_accent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Gym.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPS"
                android:textColor="@color/gym_on_accent" />

            <TextView
                android:id="@+id/reps_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/gym_on_accent"
                android:textSize="40sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Gym.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Gym.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUT" />

            <TextView
                android:id="@+id/tut_value"
                style="@style/Gym.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0.0 s"
                android:textColor="@color/gym_cyan" />
        </LinearLayout>

        <LinearLayout
            style="@style/Gym.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Gym.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG ROM" />

            <TextView
                android:id="@+id/rom_value"
                style="@style/Gym.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@color/gym_violet" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/rep_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_default">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <include layout="@layout/item_rep_header" />

            <!-- One row per rep, added when a REP packet arrives -->
            <LinearLayout
                android:id="@+id/rep_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/heart_card"
        layout="@layout/item_heart_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/finish_hint"
        style="@style/Gym.Text.CardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Finish unlocks after 5 s without movement"
        android:textSize="12sp" />
</LinearLayout>
