<?xml version="1.0" encoding="utf-8"?>
<!-- 1.1.1 · Exercise details: the sets of one exercise -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Gym.BackButton" />

        <FrameLayout
            android:id="@+id/equipment_tile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_tile">

            <ImageView
                android:id="@+id/equipment_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/exercise_name"
                style="@style/Gym.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/exercise_equipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column titles: same widths as item_set_row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:text="SET"
            android:textSize="11sp" />

        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PREVIOUS"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/weight_column_title"
            style="@style/Gym.Text.Label"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="LBS"
            android:textSize="11sp" />

        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="REPS"
            android:textSize="11sp" />

        <Space
            android:layout_width="96dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Set rows and rest timers, added by ExerciseDetailsActivity -->
            <LinearLayout
                android:id="@+id/sets_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/add_set_button"
                    style="@style/Gym.Button.Dashed"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="+  Add set"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete_set_button"
                    style="@style/Gym.Button.Danger"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:text="Delete set" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- No sensor: type the reps by hand -->
    <LinearLayout
        style="@style/Gym.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile"
            android:backgroundTint="@color/gym_surface_high">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                app:tint="@color/gym_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No sensor connected?"
                android:textColor="@color/gym_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Gym.Text.CardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type the reps yourself." />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/manual_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Type the reps by hand" />
    </LinearLayout>
</LinearLayout>
