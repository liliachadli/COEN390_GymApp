<?xml version="1.0" encoding="utf-8"?>
<!-- One template on the dashboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Gym.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <View
        android:id="@+id/template_color"
        android:layout_width="36dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_pill" />

    <TextView
        android:id="@+id/template_name"
        style="@style/Gym.Text.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/template_muscles"
        style="@style/Gym.Text.CardSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/template_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
