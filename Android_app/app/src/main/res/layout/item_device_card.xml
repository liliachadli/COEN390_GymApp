<?xml version="1.0" encoding="utf-8"?>
<!-- One sensor of the bracelet in the Devices sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/device_tile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tile">

            <ImageView
                android:id="@+id/device_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/gym_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_name"
                style="@style/Gym.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/device_detail"
                style="@style/Gym.Text.CardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/device_status"
            style="@style/Gym.Chip" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/device_button"
        style="@style/Gym.Button.Grey"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:textSize="15sp" />
</LinearLayout>
