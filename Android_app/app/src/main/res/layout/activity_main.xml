<?xml version="1.0" encoding="utf-8"?>
<!-- Live raw data screen (Sprint 1). The ids are the same as before, so MainActivity.java does not change. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE DATA"
            android:textColor="@color/gym_accent" />

        <TextView
            style="@style/Gym.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sensor readings" />

        <TextView
            style="@style/Gym.Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Press Start to show the live values from the tracker." />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MOTION · ACCELERATION (g)" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X" />

                <TextView
                    android:id="@+id/text_xaccel"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y" />

                <TextView
                    android:id="@+id/text_yaccel"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Z" />

                <TextView
                    android:id="@+id/text_zaccel"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

        </LinearLayout>
        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MOTION · ROTATION (°/s)" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X" />

                <TextView
                    android:id="@+id/text_xgyro"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y" />

                <TextView
                    android:id="@+id/text_ygyro"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Z" />

                <TextView
                    android:id="@+id/text_zgyro"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

        </LinearLayout>
        <TextView
            style="@style/Gym.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="HEART RATE SENSOR · LIGHT" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RED" />

                <TextView
                    android:id="@+id/text_redcount"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/Gym.ValueCard">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INFRARED" />

                <TextView
                    android:id="@+id/text_ircount"
                    style="@style/Gym.Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:autoSizeMaxTextSize="19sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:layout_marginTop="6dp"
                    android:text="—" />
            </LinearLayout>

        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            style="@style/Gym.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Start"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            style="@style/Gym.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Stop" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Log out"
        android:textColor="@color/gym_text_secondary" />

</LinearLayout>
