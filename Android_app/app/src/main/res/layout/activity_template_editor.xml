<?xml version="1.0" encoding="utf-8"?>
<!-- 1.2 · New / edit template -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_side"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/screen_side"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Gym.BackButton" />

        <TextView
            android:id="@+id/page_title"
            style="@style/Gym.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="New template"
            android:textSize="24sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Gym.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="NAME" />

            <EditText
                android:id="@+id/template_name_input"
                style="@style/Gym.Input"
                android:hint="e.g. Upper body"
                android:inputType="textCapWords"
                android:maxLength="24" />

            <TextView
                style="@style/Gym.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="COLOR" />

            <!-- 6 color dots, added by TemplateEditorActivity -->
            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Gym.Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EXERCISES" />

                <TextView
                    android:id="@+id/template_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gym_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty_text"
                style="@style/Gym.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="No exercises yet. Add some below." />

            <!-- One row per exercise, added by TemplateEditorActivity -->
            <LinearLayout
                android:id="@+id/template_exercise_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/add_exercises_button"
                style="@style/Gym.Button.Dashed"
                android:clickable="true"
                android:focusable="true"
                android:text="+  Add exercises" />

            <!-- Edit mode only -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_template_button"
                style="@style/Gym.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Delete template"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_template_button"
        style="@style/Gym.Button.Primary"
        android:layout_marginTop="8dp"
        android:text="Save template"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart" />
</LinearLayout>
