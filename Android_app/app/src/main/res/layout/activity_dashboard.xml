<?xml version="1.0" encoding="utf-8"?>
<!-- 1 · Dashboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="100dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dash_greeting"
                            style="@style/Gym.Text.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good evening" />

                        <TextView
                            style="@style/Gym.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workout"
                            android:textSize="32sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/motion_chip"
                        style="@style/Gym.Chip"
                        android:layout_marginTop="6dp"
                        android:text="● Motion" />

                    <TextView
                        android:id="@+id/heart_chip"
                        style="@style/Gym.Chip"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:text="● Heart" />
                </LinearLayout>

                <!-- Big lime card -->
                <LinearLayout
                    android:id="@+id/start_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_tile"
                    android:backgroundTint="@color/gym_accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/gym_bg">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play"
                            app:tint="@color/gym_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/start_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Start empty workout"
                            android:textColor="@color/gym_on_accent"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/start_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add exercises as you go"
                            android:textColor="@color/gym_on_accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Gym.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MY TEMPLATES" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_template_button"
                        style="@style/Gym.Button.SmallOutline"
                        android:text="+ Template" />
                </LinearLayout>

                <!-- Template cards are added here by DashboardActivity (2 per row) -->
                <LinearLayout
                    android:id="@+id/templates_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Gym.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Gym.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THIS WEEK" />

                        <TextView
                            android:id="@+id/week_count"
                            style="@style/Gym.Text.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0 workouts" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        style="@style/Gym.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Gym.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAST PR" />

                        <TextView
                            android:id="@+id/last_pr"
                            style="@style/Gym.Text.Stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:text="—"
                            android:textColor="@color/gym_amber"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Round button: opens the Devices sheet -->
        <ImageButton
            android:id="@+id/devices_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_tile"
            android:backgroundTint="@color/gym_cyan"
            android:contentDescription="Devices"
            android:elevation="6dp"
            android:padding="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bluetooth"
            app:tint="@color/gym_on_accent" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Gym.BottomNav"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
