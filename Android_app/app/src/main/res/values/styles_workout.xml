<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark theme used by the workout setup screens -->
    <style name="Theme.SmartGymTracker.Workout" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gym_accent</item>
        <item name="colorOnPrimary">@color/gym_on_accent</item>
        <item name="android:windowBackground">@color/gym_bg</item>
        <item name="android:statusBarColor">@color/gym_bg</item>
        <item name="android:navigationBarColor">@color/gym_bg</item>
    </style>

    <!-- Big lime button at the bottom of each screen -->
    <style name="Gym.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="iconTint">@color/btn_primary_text</item>
    </style>

    <!-- Empty base styles: Android needs a parent for names like "Gym.Text.Title" -->
    <style name="Gym" />
    <style name="Gym.Text" />
    <style name="Gym.Button" />

    <style name="Gym.Text.Title">
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="Gym.Text.Subtitle">
        <item name="android:textColor">@color/gym_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Gym.Text.Label">
        <item name="android:textColor">@color/gym_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Gym.Text.CardTitle">
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Gym.Text.CardSubtitle">
        <item name="android:textColor">@color/gym_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Outlined button (Stop) -->
    <style name="Gym.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gym_text</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/gym_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text field used on login and register -->
    <style name="Gym.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textColorHint">@color/gym_text_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Small value card on the live data screen -->
    <style name="Gym.ValueCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card_default</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Gym.Text.Value">
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Bottom bar -->
    <style name="Gym.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/gym_nav_bg</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Gym.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Gym.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/gym_accent_tint</item>
    </style>

    <!-- Small lime button (Select, Start, Finish) -->
    <style name="Gym.Button.Small" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="iconTint">@color/btn_primary_text</item>
    </style>

    <!-- Small button with a grey border (Edit, Select on other exercises) -->
    <style name="Gym.Button.SmallOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gym_text</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/gym_body</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Red outlined button (Cancel, Delete set, Log out) -->
    <style name="Gym.Button.Danger" parent="Gym.Button.SmallOutline">
        <item name="android:textColor">@color/gym_coral</item>
        <item name="strokeColor">@color/gym_danger_stroke</item>
    </style>

    <!-- Dark grey full-width button (Done in sheets) -->
    <style name="Gym.Button.Grey" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/gym_surface_high</item>
        <item name="android:textColor">@color/gym_text</item>
    </style>

    <!-- Dashed "Add ..." button -->
    <style name="Gym.Button.Dashed">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_dashed</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Square back arrow -->
    <style name="Gym.BackButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_square_button</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="android:padding">11dp</item>
        <item name="android:contentDescription">Back</item>
        <item name="tint">@color/gym_text</item>
    </style>

    <!-- Status chip (Connected, MOVING, 1 PR) -->
    <style name="Gym.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card with padding -->
    <style name="Gym.Card">
        <item name="android:background">@drawable/bg_card_default</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Big number in a stat card -->
    <style name="Gym.Text.Stat">
        <item name="android:textColor">@color/gym_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Profile text fields -->
    <style name="Gym.Input.Small" parent="Gym.Input">
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- M/F and lbs/kg buttons -->
    <style name="Gym.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="strokeColor">@color/gym_stroke</item>
    </style>

</resources>
